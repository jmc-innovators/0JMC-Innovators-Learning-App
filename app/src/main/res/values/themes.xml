<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the real theme; this only covers the window before the first frame. -->
    <style name="Theme.JMC" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.JMC.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/jmc_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.JMC</item>
    </style>
</resources>
