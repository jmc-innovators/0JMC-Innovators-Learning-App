# JMC Innovators Release Signing Template
# Copy this file to 'keystore.properties' and fill in your actual credentials.
# 'keystore.properties' is git-ignored and must never be committed.

JMC_RELEASE_STORE_FILE=jmc-release-key.jks
JMC_RELEASE_STORE_PASSWORD=your-keystore-password
JMC_RELEASE_KEY_ALIAS=jmc-release
JMC_RELEASE_KEY_PASSWORD=your-key-password
